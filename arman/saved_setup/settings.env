# Edit these once. Both the Python code and the shell scripts read this file.
# Find the ports with: lerobot-find-port
# Find camera indexes with: lerobot-find-cameras opencv
# No inline comments after values (keeps both parsers happy).

FOLLOWER_PORT=/dev/tty.usbmodem5A680122691
FOLLOWER_ID=hack_follower
LEADER_PORT=/dev/tty.usbmodem5AE60587711
LEADER_ID=hack_leader

# Camera looking at the table from the front/top. Required for the learned model.
# Now: the iPhone (Continuity Camera). Its number changes when cameras are plugged in or out:
# check with `python cam_test.py` in the Terminal app. The iPhone gives 640x360, not 640x480.
FRONT_CAM=iphone
FRONT_WIDTH=640
FRONT_HEIGHT=360
# Second camera for MolmoAct2, from the side. do_task.py finds cameras by name: iphone, webcam (MacBook or USB), or a number.
# realsense = the D435i's colour camera: first run  sudo .venv/bin/python realsense_bridge.py  in its own Terminal tab.
SIDE_CAM=webcam
SIDE_WIDTH=640
SIDE_HEIGHT=480
# Camera on the wrist. Leave empty if you have only one camera.
WRIST_CAM=

# Your Hugging Face username (check with: hf auth whoami)
HF_USER=armannnnnnn
DATASET_NAME=so101_chess_to_cup
TASK="Put the pawn in the cup"

# MolmoAct2 on Lightning AI (scripts/run_molmo.sh). The SSH address can change if the Studio switches machine.
LIGHTNING_SSH=YOUR_STUDIO_ID@ssh.lightning.ai
MOLMO_TASK="move the arm towards the white pawn, grasp it, lift it up, and drop it into the cup"
# Fine-tuned model to use instead of the base one (scripts/train_molmo.sh prints the path). Empty = base model.
MOLMO_CHECKPOINT=

# Help for the model in do_task.py (assist.py). To get the old behaviour back: AUTO_DROP=0, RETRIES=0, GRIP_STRENGTH=normal
# AUTO_DROP=1: once the gripper holds the object, the code lifts it, carries it to the taught drop pose and opens.
#   Teach the drop pose once per container: python teach_drop.py cup   (until then the model drops by itself)
AUTO_DROP=1
# After a missed grab (gripper closed on nothing): open, lift a little, and let the model try again, up to this often.
RETRIES=2
# strong = the gripper keeps more force while squeezing (LeRobot turns it down to protect the motor); normal = LeRobot's.
GRIP_STRENGTH=strong
